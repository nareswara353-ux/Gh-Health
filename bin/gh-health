#!/usr/bin/env ruby

require_relative "../lib/gh_health"
require "optparse"

options = {
  repo_path: ".",
  github_email: nil,
  github_username: nil,
  format: :text,
  save_email: false,
  auto_detect: false,
  fix: false,
  batch: false
}

OptionParser.new do |opts|
  opts.banner = "Usage: gh-health [options]"
  opts.on("-p", "--path PATH", "Path to repo (default: .)") { |v| options[:repo_path] = v }
  opts.on("-e", "--email EMAIL", "GitHub verified email") { |v| options[:github_email] = v }
  opts.on("-u", "--username USER", "GitHub username (for --auto-detect-email)") { |v| options[:github_username] = v }
  opts.on("--auto-detect-email", "Fetch verified email from GitHub API") { options[:auto_detect] = true }
  opts.on("--save-email", "Persist email to ~/.config/gh-health/config.yml") { options[:save_email] = true }
  opts.on("--batch", "Audit all git repos in --path directory") { options[:batch] = true }
  opts.on("--fix", "Attempt to auto-fix failed checks") { options[:fix] = true }
  opts.on("--json", "Output as JSON") { options[:format] = :json }
  opts.on("-l", "--list", "List all available checkers") do
    GhHealth::Checkers::ALL.each { |c| puts c.name.split("::").last }
    exit
  end
  opts.on("-v", "--version", "Show version") do
    puts "gh-health #{GhHealth::VERSION}"
    exit
  end
  opts.on("-h", "--help", "Show help") do
    puts opts
    exit
  end
end.parse!

config = GhHealth::Config.new

if options[:auto_detect]
  if options[:github_username].nil?
    warn "Error: --auto-detect-email requires --username"
    exit 2
  end
  detected = GhHealth::VerifiedEmailFetcher.new(username: options[:github_username]).call
  if detected
    options[:github_email] = detected
    puts "Auto-detected email: #{detected}"
  else
    warn "Warning: Could not auto-detect email — falling back to config/args"
  end
end

if options[:save_email]
  if options[:github_email].nil?
    warn "Error: --save-email requires --email"
    exit 2
  end
  config.github_email = options[:github_email]
  puts "Saved email: #{options[:github_email]}"
end

github_email = options[:github_email] || config.github_email

if options[:batch]
  batch = GhHealth::BatchAuditor.new(
    base_path: options[:repo_path],
    github_email: github_email
  )
  batch_result = batch.call
  puts GhHealth::BatchReport.new(batch_result, format: options[:format]).render
  exit(batch_result[:failed].zero? ? 0 : 1)
end

auditor = GhHealth::Auditor.new(
  repo_path: options[:repo_path],
  github_email: github_email
)

result = auditor.call
puts GhHealth::Report.new(result, format: options[:format]).render

if options[:fix] && result[:failed].positive?
  fixer = GhHealth::Fixer.new(
    result: result,
    repo_path: options[:repo_path],
    github_email: github_email
  )
  fix_result = fixer.call
  puts "\n=== Auto-fix applied ==="
  fix_result[:details].each do |d|
    icon = d[:ok] ? "✅" : "❌"
    puts "#{icon} [#{d[:checker]}] #{d[:message]}"
  end
  puts "#{fix_result[:applied]} fix(es) applied, #{fix_result[:skipped]} skipped"
end

exit(result[:failed].zero? ? 0 : 1)
